# ==============================================================================
# Airtel Stadium360 — Environment Configuration Template
# Copy this file to .env and customize values for your deployment environment
# ==============================================================================

# --- Application Core ---
PROJECT_NAME="Airtel Stadium360 API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"


# --- Database Configuration ---
# 1. Local SQLite fallback:
# DATABASE_URL="sqlite:///./stadium360.db"
# 2. Neon Serverless PostgreSQL (Recommended for cloud/Render):
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-autumn-waterfall-96434848.us-east-2.aws.neon.tech/neondb?sslmode=require"
# 3. Local PostgreSQL Container:
DATABASE_URL="sqlite:///./stadium360.db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="stadium360"
POSTGRES_PORT=5432

# --- Security & JWT Authentication ---
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="airtel_stadium360_super_secret_competition_key_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS Allowed Origins ---
# Supports JSON array or comma-separated list
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","https://airtel-stadium360.vercel.app"]

# --- Frontend Client Configuration (Vercel) ---
# For local development: "/api/v1"

# For Vercel production: "https://airtel-stadium360-backend.onrender.com/api/v1"
VITE_API_URL="/api/v1"
PORT=80
