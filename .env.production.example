# ==============================================================================
# Airtel Stadium360 — Production Environment Template
# Use in hardened Docker Compose or Kubernetes deployments
# ==============================================================================

# --- Application Core ---
PROJECT_NAME="Airtel Stadium360 Production API"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=False
API_V1_STR="/api/v1"

# --- Production PostgreSQL Cluster ---
POSTGRES_USER="airtel_admin"
POSTGRES_PASSWORD="CHANGE_ME_TO_STRONG_PASSWORD_32_CHARS"
POSTGRES_DB="airtel_stadium360"
DATABASE_URL="postgresql://airtel_admin:CHANGE_ME_TO_STRONG_PASSWORD_32_CHARS@db:5432/airtel_stadium360"

# --- Redis Caching ---
REDIS_URL="redis://redis:6379/0"

# --- Production Security & Cryptography ---
# CRITICAL: Replace with cryptographic random token (openssl rand -hex 32)
SECRET_KEY="GENERATE_AND_PASTE_64_CHAR_HEX_KEY_HERE"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Production CORS Allowed Origins ---
BACKEND_CORS_ORIGINS=["https://stadium360.airtel.in","https://telemetry.stadium.airtel.com"]

# --- Frontend Ingress & Ports ---
VITE_API_URL="/api/v1"
PORT=80

